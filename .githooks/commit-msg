#!/bin/sh
# Conventional Commits with a short subject, enforced.
subject=$(head -1 "$1")
if ! printf '%s' "$subject" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: [a-z].{0,49}$'; then
  echo "commit-msg: subject must be Conventional Commits, <=50 chars after 'type: ', lowercase start:" >&2
  echo "  got: $subject" >&2
  exit 1
fi
case "$subject" in *.) echo "commit-msg: no trailing period" >&2; exit 1;; esac
