{
  "service": {
    "name": "harbour-api",
    "listen": { "host": "0.0.0.0", "port": 8080, "backlog": 128 },
    "tls": { "enabled": false, "min_version": "1.2", "ciphers": ["ECDHE-RSA-AES128-GCM-SHA256"] }
  },
  "log": { "level": "info", "sinks": ["stdout"], "redact": ["authorization"] },
  "limits": { "rps": 200, "burst": 50 },
  "retries": 3
}
