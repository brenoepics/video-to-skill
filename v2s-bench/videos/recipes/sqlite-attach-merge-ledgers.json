  "narration": [
    {
      "t": 0.6,
      "text": "Two files, a table of the same shape in each, and one identifier that appears in both."
    },
    {
      "t": 6.5,
      "text": "A connection only sees the file you opened. The other table simply is not there, and it says which name it could not find."
    },
    {
      "t": 17.5,
      "text": "Bring the second file in under a name of its own, in the same session, and now it can be read across. The overlapping identifier collides, and it names the column."
    },
    {
      "t": 28.5,
      "text": "The insert has to be told what to do when they collide. There is more than one answer and only one of them keeps the row that was already here."
    },
    {
      "t": 37.0,
      "text": "Three rows. The reading that was already here still reads as it did, not as the incoming file had it."
    }
  ],
  "notes": "A readings table between differently named databases; the task uses other files and other rows."
