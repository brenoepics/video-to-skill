  "narration": [
    {
      "t": 0.6,
      "text": "The branch that work was committed on has been deleted. There is no sign of it here."
    },
    {
      "t": 6.5,
      "text": "The log of where HEAD has been does not have it either, because it was never checked out. The usual recovery route finds nothing."
    },
    {
      "t": 15.0,
      "text": "So ask git to audit its own object store for things nothing points at. The subcommand is on screen."
    },
    {
      "t": 26.5,
      "text": "There it is, with the committer record it was made with -- which is the part a fresh commit of the same files could never match."
    },
    {
      "t": 38.0,
      "text": "Put a branch back on it and it is reachable again. No commit was made and nothing was rewritten."
    },
    {
      "t": 46.0,
      "text": "Same commit, now on a branch."
    }
  ],
  "notes": "A different repository and branch name; the task's commit, subject and dates differ."
}
