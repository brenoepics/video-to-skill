  "narration": [
    {
      "t": 0.6,
      "text": "Two captures of the same session. Different lengths, and each brought its own sound."
    },
    {
      "t": 7.7,
      "text": "Give the graph's result a name of its own and ffmpeg stops choosing for you. It says so plainly."
    },
    {
      "t": 20.3,
      "text": "So we say what goes in: the graph's result, then the one sound track we want out of the two, and a limit so it ends with whichever input runs out first. Three separate decisions."
    },
    {
      "t": 30.7,
      "text": "One picture of twice the height, one sound track, and it ends with the shorter of the two."
