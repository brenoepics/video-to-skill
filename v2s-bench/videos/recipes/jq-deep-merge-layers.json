  "narration": [
    {
      "t": 0.6,
      "text": "Two layers of worker settings. The second is meant to override only the things it actually mentions."
    },
    {
      "t": 6.5,
      "text": "The fold everyone reaches for first. Watch what comes out."
    },
    {
      "t": 16.0,
      "text": "Every setting the override was silent about has gone with it. The override replaced each object instead of going into it."
    },
    {
      "t": 25.5,
      "text": "The other way of combining two objects goes down inside them. Start from nothing, bring each file in, in order."
    },
    {
      "t": 37.5,
      "text": "Same fold, written out."
    },
    {
      "t": 47.0,
      "text": "Overrides applied, and everything beside them still here."
    }
  ],
  "notes": "Queue-worker keys, two layers; the task has three layers of a different service."
