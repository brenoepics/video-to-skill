          "  \"workers\": 8",
          "}"
        ]
      }
    },
    {
      "t": 15.5,
      "step": "02-what-went-missing",
      "terminal": {
        "type": "jq -s add defaults.json worker.json | jq -S 'keys_unsorted'"
