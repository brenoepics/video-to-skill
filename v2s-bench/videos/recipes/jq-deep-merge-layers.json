      "step": "03-the-fold-that-recurses",
      "terminal": {
        "type": "jq -n 'reduce inputs as $l ({}; . * $l)' defaults.json worker.json"
      }
    },
    {
      "t": 27.5,
      "step": "03-the-fold-that-recurses",
      "terminal": {
