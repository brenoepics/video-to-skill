        "title": "worker-config - bash",
        "lines": [
          "$ cat defaults.json worker.json",
          "{",
          "  \"queue\": { \"name\": \"ingest\", \"prefetch\": 16, \"ack\": \"auto\" },",
          "  \"retry\": { \"attempts\": 3, \"backoff\": \"linear\" },",
