  "narration": [
    {
      "t": 0.5,
      "text": "lath keeps settings in layers. Staging one is odd."
    },
    {
      "t": 4.8,
      "text": "Start a tree here."
    },
    {
      "t": 10.3,
      "text": "Now stage a setting. Watch the order, it is not what you expect."
    },
    {
      "t": 15.8,
      "text": "lath reads it back the way it stored it. Worth checking."
    },
    {
      "t": 21.3,
      "text": "Here is the trap. The other way round, no complaint."
    },
    {
      "t": 26.8,
      "text": "Look at the layer. An entry nobody asked for, and no error."
    },
    {
      "t": 32.3,
      "text": "So we take that out again."
    },
    {
      "t": 37.8,
      "text": "And stage the second the same way."
    },
    {
      "t": 43.3,
      "text": "Two settings, the names we wanted."
    },
    {
      "t": 47.3,
      "text": "Watch the order, and read the layer back after."
    }
  ],
  "notes": "Teaches lath's value-before-key argument order and shows the reversed order silently staging a key named after the value."
}
