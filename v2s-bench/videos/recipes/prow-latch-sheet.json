  "narration": [
    {
      "t": 0.5,
      "text": "Rendering a sheet is not releasing it."
    },
    {
      "t": 4.8,
      "text": "Render it locked together, and keep the id it prints."
    },
    {
      "t": 10.8,
      "text": "The obvious word is not the word. No such command."
    },
    {
      "t": 16.8,
      "text": "This is the one, and it takes that id."
    },
    {
      "t": 22.8,
      "text": "And the status names what has been released."
    },
    {
      "t": 28.8,
      "text": "Now suppose somebody tidies the file afterwards."
    },
    {
      "t": 34.8,
      "text": "Releasing it again is refused. What was released no longer matches."
    },
    {
      "t": 40.8,
      "text": "So we render it again, and it tells us the id."
    },
    {
      "t": 46.8,
      "text": "Release that, and it goes through."
    },
    {
      "t": 50.8,
      "text": "If the file is touched, render it again before releasing."
    }
  ],
  "notes": "Teaches that the release step is latch rather than release, that it takes the id the render printed, and that it refuses once the file has changed."
}
