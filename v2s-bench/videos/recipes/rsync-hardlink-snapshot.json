  "narration": [
    {
      "t": 0.6,
      "text": "Last week's snapshot is here, and one of the two files has moved on since."
    },
    {
      "t": 6.5,
      "text": "A plain copy first. No complaint, and the result looks right."
    },
    {
      "t": 14.5,
      "text": "But look at what is on disk. Two separate files holding identical bytes, each with one name. That is the cost nobody sees."
    },
    {
      "t": 23.5,
      "text": "Start again."
    },
    {
      "t": 30.0,
      "text": "This time rsync is pointed at last week's copy to compare against. Written this way it finds nothing, and it tells you so about the path. There is another way to spell the same place."
    },
    {
      "t": 41.2,
      "text": "Spelled the other way it does find it. The difference is on screen."
    },
    {
      "t": 48.4,
      "text": "Now the unchanged file is one file with two names, and the one that changed is its own copy in each week."
    }
  ],
  "notes": "Weekly mail snapshots; the task's trees, dates and changed file all differ."
}
