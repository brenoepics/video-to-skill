  "narration": [
    {
      "t": 0.5,
      "text": "Plans change. The sheet on disk does not notice."
    },
    {
      "t": 4.8,
      "text": "Here is the sheet as the plan stands today."
    },
    {
      "t": 10.3,
      "text": "This one moves to the later wave, not added twice."
    },
    {
      "t": 15.8,
      "text": "And this one is retired, which is its own step, not a far-off wave."
    },
    {
      "t": 21.3,
      "text": "But the sheet still describes the old shape. No warning."
    },
    {
      "t": 26.8,
      "text": "The plan itself is right: two units, two waves."
    },
    {
      "t": 32.3,
      "text": "So we render it again, locked together as before."
    },
    {
      "t": 37.8,
      "text": "Now it matches the plan, retired unit gone."
    },
    {
      "t": 41.8,
      "text": "Then render again. The sheet is a snapshot, not a view."
    }
  ],
  "notes": "Teaches that re-planning a unit moves it, that removal is its own step, and that the rendered sheet does not follow later plan changes."
}
