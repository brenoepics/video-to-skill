  "narration": [
    {
      "t": 0.5,
      "text": "Too many pieces per batch. Fixing that is two steps."
    },
    {
      "t": 4.8,
      "text": "Prepared, and set to take four at a time. We want two."
    },
    {
      "t": 10.8,
      "text": "So we edit that one field."
    },
    {
      "t": 16.8,
      "text": "Two it is."
    },
    {
      "t": 22.8,
      "text": "But look at the last line. It still holds what it read before."
    },
    {
      "t": 28.8,
      "text": "And it will not fire like that. One line, no advice."
    },
    {
      "t": 34.8,
      "text": "So prepare it again, which picks the edit up."
    },
    {
      "t": 40.8,
      "text": "Now it fires, names the batch, and says where it went."
    },
    {
      "t": 46.8,
      "text": "And here is what it took, which may surprise you."
    },
    {
      "t": 50.8,
      "text": "Edit, prepare again, then fire. In that order."
    }
  ],
  "notes": "Teaches the hold-count field, that a changed description leaves the lane stale until it is prepared again, and that a batch keeps the last pieces in name order."
}
