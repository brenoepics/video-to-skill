  "narration": [
    {
      "t": 0.6,
      "text": "Eight commits. The check passes at the oldest one and fails at the tip, and nobody knows which commit did it."
    },
    {
      "t": 5.5,
      "text": "The check has three answers, not two. The third one is for a revision it cannot judge at all, and it matters in a moment."
    },
    {
      "t": 14.0,
      "text": "Hand git both ends of the range. The order they go in catches people out, so read it off the screen rather than guessing."
    },
    {
      "t": 22.5,
      "text": "Now let it run the check itself. Watch it step over a revision it cannot judge: the script reports that case apart from passing and failing, and git treats it accordingly."
    },
    {
      "t": 32.0,
      "text": "And let go when it is done, or you are left parked on a detached revision with the search still open."
    },
    {
      "t": 40.0,
      "text": "Back on the branch, clean, nothing in progress."
    }
  ],
  "notes": "A different helper and eight commits; the task's repository, verdict script and subjects all differ."
}
