---
/**
 * What stands in for a figure when there is nothing to draw.
 *
 * Deliberately not an empty chart: no axis, no tick labels, no zero line, no
 * placeholder bars. An empty frame with numbers on it is still a picture of
 * numbers, and a cropped screenshot of one would misrepresent the state of
 * this benchmark. So the figure is replaced by a sentence.
 */
interface Props {
  title: string;
  body: string;
}

const { title, body } = Astro.props;
---

<div class="empty">
  <svg
    class="empty__icon"
    width="18"
    height="18"
    viewBox="0 0 18 18"
    aria-hidden="true"
    fill="none"
  >
    <circle cx="9" cy="9" r="7.25" stroke="var(--text-secondary)" stroke-width="1.5"></circle>
    <path d="M5.2 12.8 12.8 5.2" stroke="var(--text-secondary)" stroke-width="1.5"></path>
  </svg>
  <p class="empty__title">{title}</p>
  <p class="empty__body">{body}</p>
</div>
