---
import '../styles/global.css';
import { href, isCurrent } from '../lib/url';
import { REPO_URL, REPO_BENCH_PATH } from '../../site.config.mjs';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { label: 'Results', to: '/' },
  { label: 'Methodology', to: '/methodology' },
  { label: 'Tasks', to: '/tasks' },
  { label: 'Reproduce', to: '/reproduce' },
];

const bench = `${REPO_URL}/tree/main/${REPO_BENCH_PATH}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title} · v2s-bench</title>
    <meta name="description" content={description} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={new URL(path, Astro.site ?? 'https://v2s.dev').toString()} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell site-header__inner">
        <a class="brand" href={href('/')}>
          <svg
            class="brand__mark"
            width="26"
            height="26"
            viewBox="0 0 26 26"
            role="img"
            aria-label="v2s"
            fill="none"
          >
            <rect
              x="1"
              y="1"
              width="24"
              height="24"
              rx="6"
              stroke="currentColor"
              stroke-width="1.5"
            />
            <path d="M8 8.2 L13 13 L8 17.8 Z" fill="currentColor" />
            <path
              d="M15.5 9.5h3.2M15.5 13h3.2M15.5 16.5h3.2"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
          </svg>
          <span>v2s-bench<span class="brand__sub"> &middot; results</span></span>
        </a>
        <nav class="nav" aria-label="Sections">
          {
            nav.map((item) => (
              <a
                href={href(item.to)}
                aria-current={isCurrent(path, item.to) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main" class="shell">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell">
        <p>
          v2s-bench is the extrinsic utility benchmark for
          <a href={REPO_URL}>video-to-skill</a>. The suite, the harness, the
          pre-registration and this site are in
          <a href={bench}>{REPO_BENCH_PATH}/</a>.
        </p>
        <p>
          Every figure on this site is generated from one report bundle that validates
          against <code>schemas/report.schema.json</code>. Nothing is typed in by hand.
        </p>
      </div>
    </footer>
  </body>
</html>
